{% extends "base.njk" %}

{% block content %}
  <!-- Page header -->
  <header class="page-header">
    <div class="container">
      <h1>{{ title }}</h1>
      {% if subtitle %}<p>{{ subtitle }}</p>{% endif %}
    </div>
  </header>

  <!-- Content -->
  <section class="section">
    <div class="container">
      {% if intro %}
      <p style="max-width:700px;margin:0 auto 2rem;text-align:center;color:var(--gray);">{{ intro | safe }}</p>
      {% endif %}

      {% for section in committee.sections %}
      <div class="committee__section">
        <h2 class="committee__section-title">{{ section.title }}</h2>
        <div class="committee__grid">
          {% for member in section.members %}
          <div class="committee__card animate-on-scroll">
            {% if member.image %}
            <img src="/{{ member.image }}" alt="{{ member.name }}" class="committee__avatar">
            {% else %}
            <div class="committee__avatar committee__avatar--placeholder" aria-hidden="true"></div>
            {% endif %}
            <p class="committee__name">{{ member.name }}</p>
            <p class="committee__role">{{ member.role }}</p>
          </div>
          {% endfor %}
        </div>
        {% if section.footer %}
        <p class="committee__section-footer">{{ section.footer }}</p>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
{% endblock %}
